# Stripe — secret key from https://dashboard.stripe.com/apikeys (sk_live_… for real payments)
STRIPE_SECRET_KEY=

# Upstash Redis (Vercel → Storage → Upstash for Redis) — powers the anonymous archetype stats.
# Optional: without it the "Live comparison" card is simply hidden.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: canonical URL for share links, sitemap and social previews.
# On Vercel the production domain is picked up automatically.
NEXT_PUBLIC_SITE_URL=
